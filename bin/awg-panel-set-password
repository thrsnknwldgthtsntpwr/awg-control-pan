#!/usr/bin/env python3
"""Set panel login/password in /etc/awg-panel/config.ini: sudo awg-panel-set-password."""
import configparser
import getpass
import os
import re
import sys
import tempfile

conffile = "/etc/awg-panel/config.ini"
if len(sys.argv) > 1:
    conffile = sys.argv[1]

_LOGIN_RE = re.compile(r"^[A-Za-z0-9_.\-]{1,64}$")

cur_user = "admin"
if os.path.isfile(conffile):
    cp0 = configparser.ConfigParser(interpolation=None)
    try:
        cp0.read(conffile, encoding="utf-8")
        if "users" in cp0:
            try:
                cur_user = (cp0["users"].get("user.1", cur_user) or cur_user).strip() or cur_user
            except Exception:
                pass
    except Exception:
        pass

user = input(f"Логин панели [{cur_user}]: ").strip() or cur_user
if not _LOGIN_RE.match(user):
    print("Логин: 1..64 символов [A-Za-z0-9_.-], без пробелов", file=sys.stderr)
    sys.exit(1)
pw = getpass.getpass("Новый пароль панели: ")
pw2 = getpass.getpass("Повторите: ")
if pw != pw2:
    print("Не совпадают", file=sys.stderr)
    sys.exit(1)
if len(pw) < 1:
    print("Пустой пароль запрещён", file=sys.stderr)
    sys.exit(1)
if pw != pw.strip() or any(ord(c) < 32 or ord(c) == 127 for c in pw):
    print("Пароль не должен содержать управляющие символы или пробелы по краям", file=sys.stderr)
    sys.exit(1)

cp = configparser.ConfigParser(interpolation=None)
if os.path.isfile(conffile):
    try:
        cp.read(conffile, encoding="utf-8")
    except Exception as ex:
        print(f"Не могу прочитать {conffile}: {ex}", file=sys.stderr)
        sys.exit(1)
if "server" not in cp:
    cp["server"] = {}
# Canonical store is [users] user.1/password.1 only.
if "users" not in cp:
    cp["users"] = {}
cp["users"]["user.1"] = user
cp["users"]["password.1"] = pw
d = os.path.dirname(conffile) or "."
os.makedirs(d, exist_ok=True)
# Atomic + root-only from the start: no 644 window with cleartext password.
old_umask = os.umask(0o077)
tmp = None
try:
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".config.ini.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            cp.write(f)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, conffile)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
finally:
    os.umask(old_umask)
try:
    os.chmod(conffile, 0o600)
except OSError:
    pass
try:
    os.chown(conffile, 0, 0)
except Exception:
    pass
print(f"OK: {conffile} (user.1={user})")
print("Доп. пользователи: правка [users] (user.N/password.N, N=2..254) вручную.")
print("Примените: sudo systemctl restart awg-panel")

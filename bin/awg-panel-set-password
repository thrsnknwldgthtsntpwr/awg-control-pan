#!/usr/bin/env python3
"""Set/reset panel admin password: sudo awg-panel-set-password."""
import getpass
import os
import sys

sys.path.insert(0, "/usr/share/awg-panel/src")

from awg_panel.auth import AuthStore

pwfile = "/etc/awg-panel/password"
if len(sys.argv) > 1:
    pwfile = sys.argv[1]

pw = getpass.getpass("Новый пароль панели: ")
pw2 = getpass.getpass("Повторите: ")
if pw != pw2:
    print("Не совпадают", file=sys.stderr)
    sys.exit(1)
if len(pw) < 8:
    print("Минимум 8 символов", file=sys.stderr)
    sys.exit(1)

os.makedirs(os.path.dirname(pwfile), exist_ok=True)
with open(pwfile, "w", encoding="utf-8") as f:
    f.write(AuthStore.hash_password(pw) + "\n")
os.chmod(pwfile, 0o640)
try:
    import grp
    gid = grp.getgrnam("awgpanel").gr_gid
    os.chown(pwfile, 0, gid)
except Exception:
    pass
print(f"OK: {pwfile}")

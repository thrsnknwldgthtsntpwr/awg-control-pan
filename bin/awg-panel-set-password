#!/usr/bin/env python3
"""Set panel login/password in /etc/awg-panel/config.ini: sudo awg-panel-set-password."""
import configparser
import getpass
import os
import sys

conffile = "/etc/awg-panel/config.ini"
if len(sys.argv) > 1:
    conffile = sys.argv[1]

cur_user = "admin"
if os.path.isfile(conffile):
    cp0 = configparser.ConfigParser()
    try:
        cp0.read(conffile, encoding="utf-8")
        if "server" in cp0:
            cur_user = (cp0["server"].get("webusername", cur_user) or cur_user).strip() or cur_user
    except Exception:
        pass

user = input(f"Логин панели [{cur_user}]: ").strip() or cur_user
if not user:
    user = "admin"
pw = getpass.getpass("Новый пароль панели: ")
pw2 = getpass.getpass("Повторите: ")
if pw != pw2:
    print("Не совпадают", file=sys.stderr)
    sys.exit(1)
if len(pw) < 1:
    print("Пустой пароль запрещён", file=sys.stderr)
    sys.exit(1)

cp = configparser.ConfigParser()
if os.path.isfile(conffile):
    cp.read(conffile, encoding="utf-8")
if "server" not in cp:
    cp["server"] = {}
cp["server"]["webusername"] = user
cp["server"]["webpassword"] = pw
os.makedirs(os.path.dirname(conffile) or ".", exist_ok=True)
with open(conffile, "w", encoding="utf-8") as f:
    cp.write(f)
os.chmod(conffile, 0o600)
try:
    os.chown(conffile, 0, 0)
except Exception:
    pass
print(f"OK: {conffile} (webusername={user})")
print("Примените: sudo systemctl restart awg-panel")

#!/usr/bin/env python3
"""Non-interactive password setter for postinst.

Reads plaintext ONLY from stdin (or AWG_PANEL_PW env) — never from argv,
so the password is not visible in `ps aux`.
Usage: printf '%s' "$PW" | awg-panel-set-password-internal
"""
import os
import sys

sys.path.insert(0, "/usr/share/awg-panel/src")

from awg_panel.auth import AuthStore

pw = ""
if len(sys.argv) > 1:
    print("refusing: password via argv leaks to ps; use stdin", file=sys.stderr)
    sys.exit(1)
env_pw = os.environ.get("AWG_PANEL_PW", "")
if env_pw:
    pw = env_pw
elif not sys.stdin.isatty():
    pw = sys.stdin.read().strip()
if len(pw) < 8:
    print("password too short", file=sys.stderr)
    sys.exit(1)
pwfile = "/etc/awg-panel/password"
os.makedirs(os.path.dirname(pwfile), exist_ok=True)
with open(pwfile, "w", encoding="utf-8") as f:
    f.write(AuthStore.hash_password(pw) + "\n")
os.chmod(pwfile, 0o640)
try:
    import grp
    os.chown(pwfile, 0, grp.getgrnam("awgpanel").gr_gid)
except Exception:
    pass
print(f"OK: {pwfile}")

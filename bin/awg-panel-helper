#!/bin/bash
# awg-panel-helper: safe root-owned file reads for the panel (called via sudo).
# No separate storage: exposes live installer state, strips server secrets.
# Paths are hardcoded: AWG_DIR/SERVER_CONF env is intentionally IGNORED
# (sudo env_reset strips it anyway; accepting env would allow path redirect).
set -eu -o pipefail
export LC_ALL=C
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
AWG_DIR="/root/awg"
SERVER_CONF="/etc/amnezia/amneziawg/awg0.conf"

valid_name() { [[ "$1" =~ ^[a-zA-Z0-9_-]{1,63}$ ]]; }

if [[ $# -lt 1 ]]; then
  echo "usage: $0 client-conf|client-uri|client-qr <name>|server-pubkeys|init-info" >&2
  exit 2
fi
cmd="$1"; shift
case "$cmd" in
  client-conf)
    n="${1:-}"; valid_name "$n" || { echo "bad name" >&2; exit 2; }
    f="$AWG_DIR/$n.conf"; [[ ! -L "$f" ]] || { echo "bad name" >&2; exit 2; }
    [[ -f "$f" ]] || exit 1
    /bin/cat -- "$f" ;;
  client-uri)
    n="${1:-}"; valid_name "$n" || { echo "bad name" >&2; exit 2; }
    f="$AWG_DIR/$n.vpnuri"; [[ ! -L "$f" ]] || { echo "bad name" >&2; exit 2; }
    [[ -f "$f" ]] || exit 1
    /bin/cat -- "$f" ;;
  client-qr)
    n="${1:-}"; valid_name "$n" || { echo "bad name" >&2; exit 2; }
    f="$AWG_DIR/$n.png"; [[ ! -L "$f" ]] || { echo "bad name" >&2; exit 2; }
    [[ -f "$f" ]] || exit 1
    /bin/cat -- "$f" ;;
  server-pubkeys)
    # Only names + public keys; PrivateKey never leaves the server this way.
    /usr/bin/grep -E '^#_Name = |^PublicKey = ' -- "$SERVER_CONF" ;;
  init-info)
    /usr/bin/grep -E '^(AWG_PROTOCOL|SCRIPT_VERSION)=' -- "$AWG_DIR/awgsetup_cfg.init" ;;
  *)
    echo "usage: $0 client-conf|client-uri|client-qr <name>|server-pubkeys|init-info" >&2
    exit 2 ;;
esac

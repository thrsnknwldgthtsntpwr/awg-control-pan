[server]
# Слушать везде (панель-роутер) или только localhost — на выбор.
host = 0.0.0.0
port = 8443
# Plain-HTTP редиректор ":80 -> https://<host>:port" (301, только редирект,
# контент панели по HTTP никогда не отдаётся). 0 = выключить (только HTTPS).
http_redirect_port = 80
cert = /etc/awg-panel/cert.pem
key = /etc/awg-panel/key.pem
# После правок: sudo systemctl restart awg-panel
# Блокировка входа средствами сервиса (НЕ iptables/ufw): N неверных попыток
# с одного IP -> ответ 429 на auth_lock_minutes минут.
auth_max_attempts = 5
auth_lock_minutes = 5
# Underlay инсталлера — не менять без нужды:
manage_script = /root/awg/manage_amneziawg.sh
awg_dir = /root/awg
server_conf = /etc/amnezia/amneziawg/awg0.conf
helper = /usr/sbin/awg-panel-helper
auth_log = /var/log/awg-panel/auth.log
session_ttl_min = 30

[client_names]
# Кнопка «Сгенерировать имя» на странице «Клиенты»: подставляет
# prefix + случайный hex из 2*rand_bytes символов
# (аналог user_$(openssl rand -hex N): rand_bytes=8 -> user_fb4c14c49c3e2483).
# prefix: [A-Za-z0-9_-], итоговая длина prefix + 2*rand_bytes <= 63.
# rand_bytes: 1..32 (вне диапазона -> clamp, мусор -> 8).
# prefix = user_
# rand_bytes = 8

[users]
# Пользователи панели: пары user.N/password.N, N=1..254, max 254.
# Любая ошибка (дубль логина, password.N без user.N, пустой пароль,
# >254, неизвестный ключ) — отказ старта, смотрите journalctl.
user.1 = admin
password.1 = admin
# user.2 = user2
# password.2 = password2

[Unit]
Description=AWG Panel (web UI over amneziawg-installer manage)
After=network.target
Wants=awg-quick@awg0.service

[Service]
Type=simple
User=awgpanel
Group=awgpanel
ExecStart=/usr/bin/python3 -m awg_panel
WorkingDirectory=/usr/share/awg-panel/src
# NOTE: NoNewPrivileges must stay OFF: panel escalates via sudo
# to manage_amneziawg.sh and awg-panel-helper. With =yes sudo fails
# ("effective uid is not 0") and all manage calls break.
NoNewPrivileges=no
PrivateTmp=yes
# NOTE: ProtectHome=yes hides /root (mount ns, applies to sudo children too),
# which breaks manage_script/helper under /root/awg. read-only keeps it visible.
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/root/awg /etc/amnezia /etc/awg-panel /usr /bin
ReadWritePaths=/var/log/awg-panel
AmbientCapabilities=
CapabilityBoundingSet=
Restart=on-failure
RestartSec=3
UMask=027

[Install]
WantedBy=multi-user.target

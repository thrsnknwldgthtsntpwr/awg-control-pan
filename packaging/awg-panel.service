[Unit]
Description=AWG Panel (web UI over amneziawg-installer manage)
After=network.target
Wants=awg-quick@awg0.service

[Service]
Type=simple
# Сервис от root, manage/helper напрямую без sudo (см. SECURITY.md).
# manage требует root (wg/iptables/конфиги).
User=root
Group=root
ExecStart=/usr/bin/python3 -m awg_panel
WorkingDirectory=/usr/share/awg-panel/src
PrivateTmp=yes
ProtectHome=no
ProtectSystem=no
Restart=on-failure
RestartSec=3
UMask=027

[Install]
WantedBy=multi-user.target

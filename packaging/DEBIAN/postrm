#!/bin/bash
set -e
case "$1" in
  purge)
    rm -f /etc/sudoers.d/awg-panel
    # Full cleanup: cert/key were generated by postinst (not conffiles,
    # dpkg would leave them), logs are not conffiles either.
    # /root/awg and /etc/amnezia are NEVER touched.
    rm -f /etc/awg-panel/cert.pem /etc/awg-panel/key.pem /etc/awg-panel/config.ini
    rmdir /etc/awg-panel 2>/dev/null || true
    rm -rf /var/log/awg-panel
    userdel awgpanel 2>/dev/null || true
    ;;
esac
systemctl daemon-reload || true
exit 0

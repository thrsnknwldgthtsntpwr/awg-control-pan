#!/bin/bash
# postinst: NEVER touches /root/awg or /etc/amnezia — only panel's own files.
set -e
case "$1" in
  configure)
    # Legacy system user (0.1.1-0.1.3 ran as awgpanel+sudo). 0.1.4+ runs
    # as root (see awg-panel.service), user is no longer needed but kept
    # for file ownership compat on upgrade; creation is harmless.
    if ! id awgpanel >/dev/null 2>&1; then
      useradd --system --no-create-home --home-dir /var/lib/awg-panel \
        --shell /usr/sbin/nologin awgpanel || true
    fi
    mkdir -p /var/lib/awg-panel /var/log/awg-panel /etc/awg-panel
    chown root:root /var/lib/awg-panel /var/log/awg-panel || true
    chmod 755 /var/lib/awg-panel /var/log/awg-panel || true
    # config default (do not overwrite existing)
    if [ ! -f /etc/awg-panel/config.ini ]; then
      cp /usr/share/awg-panel/config.ini.example /etc/awg-panel/config.ini
    fi
    # migrate: existing configs from <=0.1.3 have no webusername/webpassword
    # (auth was via /etc/awg-panel/password). Append defaults if missing.
    if ! grep -Eq '^[[:space:]]*webusername[[:space:]]*=' /etc/awg-panel/config.ini 2>/dev/null; then
      printf '\nwebusername = admin\n' >> /etc/awg-panel/config.ini
    fi
    if ! grep -Eq '^[[:space:]]*webpassword[[:space:]]*=' /etc/awg-panel/config.ini 2>/dev/null; then
      printf 'webpassword = admin\n' >> /etc/awg-panel/config.ini
    fi
    # config holds the web password in clear -> root-only.
    chmod 600 /etc/awg-panel/config.ini || true
    chown root:root /etc/awg-panel/config.ini || true
    # self-signed cert (do not overwrite existing cert/key, but always
    # heal owner/perms: service runs as root, key must be root-only.
    if [ ! -f /etc/awg-panel/cert.pem ] || [ ! -f /etc/awg-panel/key.pem ]; then
      openssl req -x509 -newkey rsa:2048 -days 825 -nodes \
        -subj "/CN=awg-panel" \
        -keyout /etc/awg-panel/key.pem -out /etc/awg-panel/cert.pem
    fi
    chown root:root /etc/awg-panel/key.pem /etc/awg-panel/cert.pem || true
    chmod 600 /etc/awg-panel/key.pem || true
    chmod 644 /etc/awg-panel/cert.pem || true
    # legacy cleanup (0.1.4+): auth is webusername/webpassword in config.ini,
    # separate password file + stdin setter are no longer used.
    rm -f /usr/sbin/awg-panel-set-password-internal || true
    rm -f /etc/awg-panel/password || true
    # sudoers is legacy too (service runs as root, no sudo calls).
    # Kept as conffile for clean upgrades; heal perms in case an old
    # 0.1.1-style file with wrong owner is still around.
    if [ -f /etc/sudoers.d/awg-panel ]; then
      chown root:root /etc/sudoers.d/awg-panel || true
      chmod 440 /etc/sudoers.d/awg-panel || true
      if command -v visudo >/dev/null 2>&1; then
        visudo -c -f /etc/sudoers.d/awg-panel || echo "WARN: sudoers check failed" >&2
      fi
    fi
    chmod 755 /usr/sbin/awg-panel-helper /usr/sbin/awg-panel-set-password || true
    systemctl daemon-reload || true
    systemctl enable awg-panel.service || true
    systemctl restart awg-panel.service || echo "WARN: start failed, see journalctl -u awg-panel" >&2
    # ---- что делать дальше (показывается после каждой установки) ----
    PORT="8443"
    if [ -f /etc/awg-panel/config.ini ]; then
      P="$(awk -F= '/^[[:space:]]*port[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' /etc/awg-panel/config.ini 2>/dev/null || true)"
      if [ -n "$P" ]; then PORT="$P"; fi
    fi
    cat >&2 <<EOF
awg-panel установлен. Существующие VPN-пользователи не тронуты.
  1. Логин/пароль: /etc/awg-panel/config.ini (webusername/webpassword, дефолт admin/admin).
     Сменить пароль: sudo awg-panel-set-password  (или правка config.ini вручную).
     После правок: sudo systemctl restart awg-panel
  2. Открыть: https://<IP-сервера>:$PORT/ (сертификат self-signed — подтвердить исключение).
     Проверка: sudo systemctl status awg-panel --no-pager; sudo journalctl -u awg-panel -n 30 --no-pager
EOF
    ;;
esac
exit 0

#!/bin/bash
set -e
case "$1" in
  remove|deconfigure)
    systemctl stop awg-panel.service || true
    ;;
  purge)
    rm -rf /var/lib/awg-panel
    # /etc/awg-panel (config/keys) and /var/log/awg-panel are cleaned in
    # postrm purge; dpkg handles conffiles. Nothing in /root/awg touched ever.
    ;;
esac
exit 0

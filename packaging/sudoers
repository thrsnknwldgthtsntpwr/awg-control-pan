# LEGACY (0.1.4+): service runs as root and calls manage/helper directly,
# sudo is no longer used. File kept for clean upgrades / fallback installs
# still running as `awgpanel`. Managed by .deb.
# Panel may only: run manage subcommands used by UI + read live files via helper.
# NOTE: validated with `visudo -c` on both classic sudo and sudo-rs.
Defaults:awgpanel env_reset
awgpanel ALL=(root) NOPASSWD: /bin/bash /root/awg/manage_amneziawg.sh --json --no-color list
awgpanel ALL=(root) NOPASSWD: /bin/bash /root/awg/manage_amneziawg.sh --json --no-color stats
awgpanel ALL=(root) NOPASSWD: /bin/bash /root/awg/manage_amneziawg.sh --json --no-color check
# NOTE: single trailing `*` covers both `add <names>` and `--expires=Nd add <names>`
# (manage argparse order: flags before subcommand). Embedded wildcards like
# `--expires=*` are rejected by sudo-rs (now default on newer Ubuntu), so they
# must NOT be used here even though classic sudo accepts them. The pinned prefix
# (binary + script + --json --no-color --yes) still confines this to manage args.
awgpanel ALL=(root) NOPASSWD: /bin/bash /root/awg/manage_amneziawg.sh --json --no-color --yes *
awgpanel ALL=(root) NOPASSWD: /bin/bash /root/awg/manage_amneziawg.sh --json --no-color --yes remove *
awgpanel ALL=(root) NOPASSWD: /bin/bash /root/awg/manage_amneziawg.sh --json --no-color --yes regen *
# Helper enumerated explicitly (no blanket `helper *`): each arg shape pinned,
# helper itself re-validates names and never emits server PrivateKey.
awgpanel ALL=(root) NOPASSWD: /usr/sbin/awg-panel-helper client-conf *
awgpanel ALL=(root) NOPASSWD: /usr/sbin/awg-panel-helper client-uri *
awgpanel ALL=(root) NOPASSWD: /usr/sbin/awg-panel-helper client-qr *
awgpanel ALL=(root) NOPASSWD: /usr/sbin/awg-panel-helper server-pubkeys
awgpanel ALL=(root) NOPASSWD: /usr/sbin/awg-panel-helper init-info
